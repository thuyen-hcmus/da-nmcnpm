# Nhà cung cấp AI: "gemini" (mặc định) hoặc "fake" (chạy không cần Internet, dùng cho test/demo dự phòng)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
# Chuỗi ngẫu nhiên dài, dùng để băm token phiên
SESSION_SECRET=
DATABASE_URL=file:./dev.db
HOST=localhost
PORT=3000
# URL mà sinh viên/máy chiếu dùng để mở link (đổi thành http://<ip-lan>:3000 khi chạy qua LAN)
PUBLIC_URL=http://localhost:3000
