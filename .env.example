# Nhà cung cấp AI: "gemini" (mặc định), "9router" hoặc "fake" (test/demo)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
# Dùng cho AI_PROVIDER=9router, ví dụ https://router.example.com/v1
AI_BASE_URL=
# Chuỗi ngẫu nhiên dài, dùng để băm token phiên
SESSION_SECRET=
DATABASE_URL=file:./dev.db
HOST=localhost
PORT=3000
# URL mà sinh viên/máy chiếu dùng để mở link (đổi thành http://<ip-lan>:3000 khi chạy qua LAN)
PUBLIC_URL=http://localhost:3000
